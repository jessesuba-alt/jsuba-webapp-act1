rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Core Auth & Payload Helpers
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Modular Admin RBAC Helper (never placed inside collection list queries)
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (
          request.auth.token.email == 'jessesuba@gmail.com' &&
          request.auth.token.email_verified == true
        )
        // Optional static UID slot — replace with your Firebase Auth UID if needed:
        // || request.auth.uid == 'REPLACE_WITH_YOUR_ADMIN_UID'
      );
    }

    // ---------------------------------------------------------
    // Domain Enum & Schema Validators (Synced with firebase-blueprint.json)
    // ---------------------------------------------------------
    function isValidGoal(goal) {
      return goal in ['Weight Loss', 'Muscle Gain', 'General Fitness'];
    }

    function isValidWorkoutEnv(env) {
      return env in ['Home', 'Gym'];
    }

    function isValidFoodEnv(env) {
      return env in ['Home-Cooked', 'On-the-Go'];
    }

    function isValidMealSlot(slot) {
      return slot in ['Breakfast', 'Lunch', 'Dinner', 'Snack'];
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'goal',
        'workoutEnv',
        'foodEnv',
        'onboarded',
        'waterCupsToday',
        'lastWaterDate',
        'completedDates',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'goal',
        'workoutEnv',
        'foodEnv',
        'onboarded',
        'waterCupsToday',
        'lastWaterDate',
        'completedDates',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string && data.uid == userId
      && data.email is string && data.email.size() <= 320
      && data.displayName is string && data.displayName.size() <= 100
      && isValidGoal(data.goal)
      && isValidWorkoutEnv(data.workoutEnv)
      && isValidFoodEnv(data.foodEnv)
      && data.onboarded is bool
      && data.waterCupsToday is int && data.waterCupsToday >= 0 && data.waterCupsToday <= 24
      && data.lastWaterDate is string && data.lastWaterDate.size() <= 10
      && data.completedDates is list && data.completedDates.size() <= 90
      && data.createdAt is int && data.createdAt > 0
      && data.updatedAt is int && data.updatedAt >= data.createdAt;
    }

    function isValidWorkout(data) {
      return data.keys().hasAll([
        'ownerId',
        'templateKey',
        'title',
        'dayLabel',
        'environment',
        'targetMuscles',
        'exercises',
        'completedExerciseIds',
        'isCompleted',
        'isCustom',
        'lastCompletedDate',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId',
        'templateKey',
        'title',
        'dayLabel',
        'environment',
        'targetMuscles',
        'exercises',
        'completedExerciseIds',
        'isCompleted',
        'isCustom',
        'lastCompletedDate',
        'createdAt',
        'updatedAt'
      ])
      && data.ownerId is string && isValidId(data.ownerId)
      && data.templateKey is string && data.templateKey.size() <= 80
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
      && data.dayLabel is string && data.dayLabel.size() >= 1 && data.dayLabel.size() <= 40
      && isValidWorkoutEnv(data.environment)
      && data.targetMuscles is string && data.targetMuscles.size() >= 1 && data.targetMuscles.size() <= 140
      && data.exercises is list && data.exercises.size() <= 20
      && data.completedExerciseIds is list && data.completedExerciseIds.size() <= 20
      && data.isCompleted is bool
      && data.isCustom is bool
      && data.lastCompletedDate is string && data.lastCompletedDate.size() <= 10
      && data.createdAt is int && data.createdAt > 0
      && data.updatedAt is int && data.updatedAt >= data.createdAt;
    }

    function isValidMeal(data) {
      return data.keys().hasAll([
        'ownerId',
        'templateKey',
        'title',
        'slot',
        'foodEnv',
        'goal',
        'calories',
        'protein',
        'carbs',
        'fat',
        'prepNotes',
        'checkedDate',
        'isCustom',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId',
        'templateKey',
        'title',
        'slot',
        'foodEnv',
        'goal',
        'calories',
        'protein',
        'carbs',
        'fat',
        'prepNotes',
        'checkedDate',
        'isCustom',
        'createdAt',
        'updatedAt'
      ])
      && data.ownerId is string && isValidId(data.ownerId)
      && data.templateKey is string && data.templateKey.size() <= 80
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
      && isValidMealSlot(data.slot)
      && isValidFoodEnv(data.foodEnv)
      && isValidGoal(data.goal)
      && data.calories is int && data.calories >= 0 && data.calories <= 5000
      && data.protein is int && data.protein >= 0 && data.protein <= 400
      && data.carbs is int && data.carbs >= 0 && data.carbs <= 600
      && data.fat is int && data.fat >= 0 && data.fat <= 300
      && data.prepNotes is string && data.prepNotes.size() <= 1000
      && data.checkedDate is string && data.checkedDate.size() <= 10
      && data.isCustom is bool
      && data.createdAt is int && data.createdAt > 0
      && data.updatedAt is int && data.updatedAt >= data.createdAt;
    }

    // ---------------------------------------------------------
    // Collection Match Rules
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming(), userId);
      allow update: if isSignedIn()
        && (request.auth.uid == userId || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && isValidUser(incoming(), userId);
      allow delete: if isAdmin();
    }

    match /workouts/{workoutId} {
      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      // Pillar 8: Never invoke isAdmin() (exists()) inside list queries
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(workoutId)
        && incoming().ownerId == request.auth.uid
        && isValidWorkout(incoming());
      allow update: if isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && isValidWorkout(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /meals/{mealId} {
      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      // Pillar 8: Never invoke isAdmin() (exists()) inside list queries
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(mealId)
        && incoming().ownerId == request.auth.uid
        && isValidMeal(incoming());
      allow update: if isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && isValidMeal(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }
  }
}
